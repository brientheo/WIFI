MARKET_DATA_API_KEY=

# --- Personal assistant agent: plug in real calendar/email providers ---
# e.g. Google Calendar + Gmail OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
